   "syl_text": 13,
   "syl_audio": 11,
   "ratio": 0.94
  },
  {
   "i": 184,
   "text": "Historian Khalid Blankinship ke mutabik, inhi haaron ne Umayyad vansh ko khatam kar diya.",
   "start": 521.53,
   "end": 526.56,
   "syl_text": 25,
   "syl_audio": 23,
   "ratio": 1.02
  },
  {
   "i": 185,
   "text": "Aur 750 mein wahi hua.",
   "start": 526.87,
   "end": 528.68,
   "syl_text": 9,
   "syl_audio": 8,
   "ratio": 0.99
  },
  {
   "i": 186,
   "text": "Abbasi kranti, aur Umayyad khilafat khatam.",
   "start": 529.02,
   "end": 531.84,
   "syl_text": 13,
   "syl_audio": 11,
   "ratio": 0.94
  },
  {
   "i": 187,
   "text": "Naye Abbasi khalifaon ne bhi koshish ki, is baar samundar se.",
