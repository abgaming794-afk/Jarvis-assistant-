   "end": 535.61,
   "syl_text": 18,
   "syl_audio": 12,
   "ratio": 0.74
  },
  {
   "i": 188,
   "text": "Lekin 776 mein Saindhava raja Agguka ki navy ne unka bedha haraya.",
