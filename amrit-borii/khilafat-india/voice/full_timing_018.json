   "end": 370.41,
   "syl_text": 12,
   "syl_audio": 12,
   "ratio": 1.11
  },
  {
   "i": 136,
   "text": "Ek mein dar tha, doosre mein ummeed.",
   "start": 370.74,
   "end": 373.19,
   "syl_text": 8,
   "syl_audio": 9,
   "ratio": 1.25
  },
  {
   "i": 137,
   "text": "Aur Al-Hakam haar maanne waala nahi tha.",
   "start": 373.55,
   "end": 375.81,
   "syl_text": 11,
   "syl_audio": 10,
   "ratio": 1.01
  },
  {
   "i": 138,
   "text": "Usne phir Gujarat ki taraf koshish ki.",
   "start": 376.12,
   "end": 378.02,
   "syl_text": 11,
   "syl_audio": 8,
   "ratio": 0.81
  },
  {
   "i": 139,
   "text": "Lekin 736 ke ek shilalekh ke mutabik Bharuch ke raja Jayabhata chauthe ne Vallabhi ki madad karte hue Arab fauj ko haraya.",
   "start": 378.4,
   "end": 386.54,
   "syl_text": 39,
   "syl_audio": 36,
   "ratio": 1.03
  },
  {
   "i": 140,
   "text": "737.",
   "start": 386.89,
   "end": 387.94,
   "syl_text": 4,
   "syl_audio": 3,
   "ratio": 0.83
  },
  {
   "i": 141,
   "text": "Al-Hakam ne Damascus se aur sainik maange.",
   "start": 388.29,
   "end": 390.85,
   "syl_text": 12,
   "syl_audio": 11,
   "ratio": 1.02
  },
