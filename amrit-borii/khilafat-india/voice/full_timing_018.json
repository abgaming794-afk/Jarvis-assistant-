   "end": 80.75,
   "syl_text": 12,
   "syl_audio": 13,
   "ratio": 1.2
  },
  {
   "i": 28,
   "text": "Ek taraf Spain.",
   "start": 81.18,
   "end": 82.12,
   "syl_text": 4,
   "syl_audio": 3,
   "ratio": 0.83
  },
  {
