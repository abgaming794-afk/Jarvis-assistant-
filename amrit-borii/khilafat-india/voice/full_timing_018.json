   "end": 424.35,
   "syl_text": 13,
   "syl_audio": 12,
   "ratio": 1.03
  },
  {
   "i": 152,
   "text": "Usi saal Chittor ke Mori rajaon ne Arab gheraabandi naakaam kar di.",
