   "end": 428.84,
   "syl_text": 21,
   "syl_audio": 19,
   "ratio": 1.01
  },
  {
   "i": 153,
   "text": "Mewar ki parampara kehti hai ki Bappa Rawal ne bhi Arabon ko khadeda.",
