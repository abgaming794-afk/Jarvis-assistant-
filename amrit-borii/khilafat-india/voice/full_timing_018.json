   "end": 346.01,
   "syl_text": 16,
   "syl_audio": 20,
   "ratio": 1.39
  },
  {
   "i": 127,
   "text": "Aur Musalmanon ke paas sar chhupane ki koi surakshit jagah nahi bachi thi.",
