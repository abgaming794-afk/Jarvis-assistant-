   "text": "Aap kis state se ho?",
   "start": 283.65,
   "end": 284.19,
   "syl_text": 5,
   "syl_audio": 3,
   "ratio": 0.67
  },
  {
   "i": 104,
   "text": "Gujarat, Rajasthan, MP ya Kashmir?",
   "start": 284.46,
   "end": 286.41,
   "syl_text": 10,
   "syl_audio": 8,
   "ratio": 0.89
  },
  {
   "i": 105,
   "text": "Comment mein likho, kyunki agle chapter mein shayad aapke hi ilaake ke raja aane wale hain.",
   "start": 286.76,
   "end": 291.35,
   "syl_text": 22,
   "syl_audio": 19,
   "ratio": 0.96
  },
