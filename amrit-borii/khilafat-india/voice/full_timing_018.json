   "end": 87.79,
   "syl_text": 11,
   "syl_audio": 11,
   "ratio": 1.11
  },
  {
   "i": 32,
   "text": "Lekin ek minute.",
   "start": 88.29,
   "end": 89.21,
   "syl_text": 5,
   "syl_audio": 3,
   "ratio": 0.67
  },
  {
   "i": 33,
   "text": "India par pehli nazar toh isse 75 saal pehle hi pad chuki thi.",
   "start": 89.58,
   "end": 92.91,
   "syl_text": 19,
   "syl_audio": 16,
   "ratio": 0.94
  },
  {
   "i": 34,
   "text": "Saal 636 ke aaspaas, samundar se teen hamle:",
   "start": 93.31,
   "end": 96.75,
   "syl_text": 14,
   "syl_audio": 13,
   "ratio": 1.03
  },
  {
   "i": 35,
   "text": "Thane, Bharuch aur Debal.",
   "start": 97.16,
   "end": 98.95,
   "syl_text": 6,
   "syl_audio": 6,
   "ratio": 1.11
  },
  {
   "i": 36,
   "text": "Aur twist ye, ki Khalifa Umar ne in hamlon ki ijaazat hi nahi di thi.",
   "start": 99.34,
   "end": 103.54,
   "syl_text": 22,
   "syl_audio": 20,
   "ratio": 1.01
  },
  {
