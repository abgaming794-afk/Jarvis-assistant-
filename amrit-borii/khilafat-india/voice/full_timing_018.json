   "end": 356.95,
   "syl_text": 3,
   "syl_audio": 1,
   "ratio": 0.37
  },
  {
   "i": 131,
   "text": "Paas mein hi Muhammad bin Qasim ke bete Amr ne doosra shehar basaya:",
