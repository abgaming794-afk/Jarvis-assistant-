   "end": 496.03,
   "syl_text": 10,
   "syl_audio": 11,
   "ratio": 1.22
  },
  {
   "i": 174,
   "text": "732:",
   "start": 496.4,
   "end": 497.43,
   "syl_text": 4,
   "syl_audio": 4,
   "ratio": 1.11
  },
