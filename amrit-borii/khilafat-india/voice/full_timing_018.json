   "end": 68.45,
   "syl_text": 3,
   "syl_audio": 8,
   "ratio": 2.96
  },
  {
   "i": 23,
   "text": "Apne charam par ye saamrajya ek crore das lakh varg kilometre se bhi bada tha.",
   "start": 68.69,
   "end": 72.88,
   "syl_text": 21,
   "syl_audio": 15,
   "ratio": 0.79
  },
  {
