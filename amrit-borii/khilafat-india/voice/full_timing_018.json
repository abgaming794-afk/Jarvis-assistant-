   "end": 561.81,
   "syl_text": 13,
   "syl_audio": 13,
   "ratio": 1.11
  },
  {
   "i": 197,
   "text": "Aur 854 ke aaspaas wo bhi chhote chhote emiraton mein bant gaya.",
