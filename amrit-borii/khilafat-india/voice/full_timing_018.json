   "end": 268.66,
   "syl_text": 10,
   "syl_audio": 7,
   "ratio": 0.78
  },
  {
   "i": 97,
   "text": "Yaad hai Umar ki baat?",
   "start": 268.87,
   "end": 270.28,
   "syl_text": 6,
   "syl_audio": 5,
   "ratio": 0.93
  },
  {
   "i": 98,
   "text": "Kharaab, gareeb zameen.",
   "start": 270.62,
   "end": 272.42,
   "syl_text": 6,
   "syl_audio": 7,
   "ratio": 1.3
  },
  {
   "i": 99,
   "text": "Raaz number do: registaan ka raasta.",
   "start": 272.64,
   "end": 276.2,
   "syl_text": 10,
   "syl_audio": 11,
   "ratio": 1.22
  },
  {
   "i": 100,
   "text": "Lekin sirf registaan se fauj nahi rukti.",
   "start": 276.53,
   "end": 278.72,
   "syl_text": 12,
   "syl_audio": 10,
   "ratio": 0.93
  },
  {
   "i": 101,
   "text": "Asli jawab abhi aana baaki hai.",
   "start": 279.01,
   "end": 282.08,
   "syl_text": 11,
   "syl_audio": 11,
   "ratio": 1.11
  },
  {
   "i": 102,
   "text": "Ek sawaal aapse.",
   "start": 282.39,
   "end": 283.36,
   "syl_text": 4,
   "syl_audio": 4,
   "ratio": 1.11
  },
