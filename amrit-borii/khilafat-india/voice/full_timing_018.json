   "end": 75.26,
   "syl_text": 8,
   "syl_audio": 6,
   "ratio": 0.83
  },
  {
   "i": 26,
   "text": "Aur saal 711.",
   "start": 75.83,
   "end": 77.28,
   "syl_text": 6,
   "syl_audio": 6,
   "ratio": 1.11
  },
  {
