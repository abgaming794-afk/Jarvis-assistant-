   "start": 298.15,
   "end": 298.78,
   "syl_text": 3,
   "syl_audio": 2,
   "ratio": 0.74
  },
  {
   "i": 112,
   "text": "Bharuch.",
   "start": 299.01,
   "end": 299.55,
   "syl_text": 2,
   "syl_audio": 1,
   "ratio": 0.56
  },
  {
   "i": 113,
   "text": "Bhinmal.",
   "start": 299.74,
   "end": 300.9,
   "syl_text": 2,
   "syl_audio": 4,
   "ratio": 2.22
  },
  {
   "i": 114,
   "text": "Malwa.",
   "start": 301.17,
   "end": 303.27,
   "syl_text": 2,
   "syl_audio": 8,
   "ratio": 4.45
  },
  {
   "i": 115,
   "text": "Teen saal mein ek ke baad ek hamle.",
   "start": 303.55,
   "end": 306.23,
   "syl_text": 8,
   "syl_audio": 13,
   "ratio": 1.81
  },
  {
   "i": 116,
   "text": "Ujjain tak pahunch gaya, lekin shehar haath nahi aaya.",
   "start": 306.58,
   "end": 309.38,
   "syl_text": 14,
   "syl_audio": 16,
   "ratio": 1.27
  },
  {
   "i": 117,
   "text": "Pratihara vansh ke baad ke ek shilalekh mein likha hai ki unke raja Nagabhata pehle ne \"taaqatwar Mlechha raja ki badi fauj ko kuchal diya\".",
   "start": 309.59,
   "end": 318.69,
   "syl_text": 41,
   "syl_audio": 39,
   "ratio": 1.06
  },
  {
   "i": 118,
   "text": "Ye ladai kab aur kahan hui, ispar historians mein behes hai.",
   "start": 318.98,
   "end": 321.76,
   "syl_text": 17,
   "syl_audio": 12,
   "ratio": 0.78
  },
  {
   "i": 119,
   "text": "Lekin aage jo hua, wo Arab sources mein darj hai.",
   "start": 322.12,
   "end": 323.6,
   "syl_text": 13,
   "syl_audio": 9,
   "ratio": 0.77
  },
  {
   "i": 120,
   "text": "Agle governor Tamim ke waqt Junayd ki saari jeet haath se nikal gayi.",
   "start": 323.84,
   "end": 326.13,
   "syl_text": 19,
   "syl_audio": 9,
   "ratio": 0.53
  },
  {
   "i": 121,
   "text": "Syria aur Yemen se aaye sainik chaukiyan chhodkar chale gaye, aur wapas aane se mana kar diya.",
   "start": 326.43,
   "end": 331.55,
   "syl_text": 24,
   "syl_audio": 23,
   "ratio": 1.07
  },
  {
   "i": 122,
   "text": "Aur ab wo line, jiska wada maine shuru mein kiya tha.",
   "start": 331.86,
   "end": 334.75,
   "syl_text": 14,
   "syl_audio": 10,
   "ratio": 0.79
  },
  {
   "i": 123,
   "text": "731.",
   "start": 335.16,
   "end": 336.37,
   "syl_text": 4,
   "syl_audio": 4,
   "ratio": 1.11
  },
  {
   "i": 124,
   "text": "Naya governor Al-Hakam Sindh pahunchta hai.",
   "start": 336.57,
   "end": 338.94,
   "syl_text": 12,
   "syl_audio": 10,
   "ratio": 0.93
  },
  {
   "i": 125,
   "text": "Arab itihaskar Baladhuri likhta hai:",
   "start": 339.25,
   "end": 341.4,
   "syl_text": 13,
   "syl_audio": 10,
   "ratio": 0.86
  },
  {
   "i": 126,
   "text": "Hind ke log, Kassa ko chhodkar, apne purane dharm par laut chuke the.",
