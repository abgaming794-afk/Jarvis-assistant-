   "i": 134,
   "text": "Socho.",
   "start": 366.74,
   "end": 367.09,
   "syl_text": 2,
   "syl_audio": 1,
   "ratio": 0.56
  },
  {
   "i": 135,
   "text": "Ek shehar ka naam \"surakshit\", doosre ka \"vijayi\".",
