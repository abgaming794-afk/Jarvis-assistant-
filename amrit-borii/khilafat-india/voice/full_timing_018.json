   "end": 399.21,
   "syl_text": 6,
   "syl_audio": 5,
   "ratio": 0.93
  },
  {
   "i": 146,
   "text": "Navsari mein mila ek taambe ka patra, saal 739 ka.",
   "start": 399.55,
   "end": 403.67,
   "syl_text": 18,
   "syl_audio": 15,
   "ratio": 0.93
  },
  {
   "i": 147,
   "text": "Ye is poori kahani ka sabse pakka saboot hai.",
   "start": 404.0,
   "end": 406.96,
   "syl_text": 14,
   "syl_audio": 13,
   "ratio": 1.03
  },
  {
   "i": 148,
   "text": "Isme likha hai ki Tajik, yaani Arab, Sindh, Kutch aur Saurashtra jaise kai rajyon ko raundte hue Navsari tak aaye.",
   "start": 407.29,
   "end": 414.62,
   "syl_text": 29,
   "syl_audio": 31,
   "ratio": 1.19
  },
  {
   "i": 149,
   "text": "Aur yahan Chalukya raja Avanijanashraya Pulakeshin ne unhe haraaya.",
