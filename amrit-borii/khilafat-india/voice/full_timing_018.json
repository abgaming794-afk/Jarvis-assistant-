   "syl_text": 13,
   "syl_audio": 13,
   "ratio": 1.11
  },
  {
   "i": 91,
   "text": "Kabul aur Zabul ne do sau saal se zyada ye deewar khadi rakhi.",
   "start": 251.33,
   "end": 255.16,
   "syl_text": 19,
   "syl_audio": 20,
   "ratio": 1.17
  },
  {
   "i": 92,
   "text": "Zunbilon ki aakhri haar 870 mein hui, wo bhi khilafat se nahi, Saffarid raja se.",
   "start": 255.47,
   "end": 260.95,
   "syl_text": 27,
   "syl_audio": 25,
   "ratio": 1.03
  },
  {
   "i": 93,
   "text": "Raaz number ek:",
   "start": 261.43,
   "end": 262.28,
   "syl_text": 4,
   "syl_audio": 4,
   "ratio": 1.11
  },
  {
   "i": 94,
   "text": "Kabul-Zabul ki deewar.",
   "start": 262.7,
   "end": 264.06,
   "syl_text": 7,
   "syl_audio": 6,
   "ratio": 0.95
  },
  {
   "i": 95,
   "text": "Toh Arabon ke paas bacha sabse mushkil raasta:",
   "start": 264.44,
   "end": 267.07,
   "syl_text": 13,
   "syl_audio": 12,
   "ratio": 1.03
  },
  {
   "i": 96,
   "text": "Makran ka registaan, Sindh, aur phir Thar.",
