   "start": 484.62,
   "end": 485.8,
   "syl_text": 3,
   "syl_audio": 3,
   "ratio": 1.11
  },
  {
   "i": 169,
   "text": "Fauj pyaas mein phans gayi.",
   "start": 486.11,
   "end": 487.45,
   "syl_text": 5,
   "syl_audio": 3,
   "ratio": 0.67
  },
