{
 "duration": 633.156,
 "units": [
  {
   "i": 0,
   "text": "Ek fauj ne sirf paanch saal mein lagbhag poora Spain jeet liya.",
   "start": 0.0,
   "end": 3.75,
   "syl_text": 14,
   "syl_audio": 13,
   "ratio": 1.03
  },
  {
   "i": 1,
   "text": "Wahi khilafat, usi daur mein, Atlantic se Central Asia tak raaj kar rahi thi.",
   "start": 4.31,
   "end": 8.76,
   "syl_text": 23,
   "syl_audio": 20,
   "ratio": 0.97
  },
  {
   "i": 2,
   "text": "Lekin Hindustan ke darwaze par, iske governor ko apne hi logon ke liye ek naya shehar banana pada.",
   "start": 9.37,
   "end": 15.16,
   "syl_text": 29,
   "syl_audio": 29,
   "ratio": 1.11
  },
  {
   "i": 3,
   "text": "Naam rakha:",
   "start": 15.69,
   "end": 16.32,
   "syl_text": 3,
   "syl_audio": 3,
   "ratio": 1.11
  },
  {
   "i": 4,
   "text": "Al-Mahfuza.",
   "start": 16.69,
   "end": 17.44,
   "syl_text": 4,
   "syl_audio": 4,
   "ratio": 1.11
  },
  {
   "i": 5,
   "text": "Matlab, \"surakshit\".",
   "start": 17.92,
   "end": 19.14,
   "syl_text": 5,
   "syl_audio": 3,
   "ratio": 0.67
  },
  {
   "i": 6,
   "text": "Jo fauj Spain jeet chuki thi, wo yahan sar chhupane ki surakshit jagah dhoondh rahi thi.",
   "start": 19.7,
   "end": 24.58,
   "syl_text": 23,
   "syl_audio": 21,
   "ratio": 1.01
  },
  {
   "i": 7,
   "text": "Aur ye main nahi keh raha.",
   "start": 25.16,
   "end": 26.22,
   "syl_text": 8,
   "syl_audio": 7,
   "ratio": 0.97
  },
  {
   "i": 8,
   "text": "Ye ek Arab itihaskar ne khud likha hai.",
   "start": 26.68,
   "end": 28.92,
   "syl_text": 13,
   "syl_audio": 11,
   "ratio": 0.94
  },
  {
   "i": 9,
   "text": "Wo line main aapko isi video mein dikhaunga.",
   "start": 29.42,
   "end": 31.43,
   "syl_text": 13,
   "syl_audio": 10,
   "ratio": 0.86
  },
  {
   "i": 10,
   "text": "Lekin pehle samajhna padega ki ye naubat aayi kyun.",
   "start": 31.92,
   "end": 34.7,
   "syl_text": 15,
   "syl_audio": 13,
   "ratio": 0.96
  },
  {
   "i": 11,
   "text": "Iske peeche chaar raaz hain.",
   "start": 35.22,
   "end": 36.69,
   "syl_text": 5,
   "syl_audio": 6,
   "ratio": 1.33
  },
  {
   "i": 12,
   "text": "Aur chautha raaz wo hai jo aaj bhi zyadatar log galat samajhte hain.",
   "start": 37.12,
   "end": 41.27,
   "syl_text": 18,
   "syl_audio": 15,
   "ratio": 0.93
  },
  {
   "i": 13,
   "text": "Namaste doston, main hoon Amrit, aur aap dekh rahe ho AMRIT BORI.",
   "start": 41.86,
   "end": 45.77,
   "syl_text": 17,
   "syl_audio": 16,
   "ratio": 1.05
  },
  {
   "i": 14,
   "text": "Yahan wo itihaas milta hai jo textbook mein nahi milta.",
   "start": 46.2,
   "end": 49.16,
   "syl_text": 17,
   "syl_audio": 14,
   "ratio": 0.92
  },
  {
   "i": 15,
   "text": "Naye ho toh subscribe kar lo.",
   "start": 49.55,
   "end": 51.06,
   "syl_text": 7,
   "syl_audio": 6,
   "ratio": 0.95
  },
  {
   "i": 16,
   "text": "Chalo, waqt mein peeche chalte hain.",
   "start": 51.52,
   "end": 53.4,
   "syl_text": 7,
   "syl_audio": 6,
   "ratio": 0.95
  },
  {
   "i": 17,
   "text": "Saal 632.",
   "start": 53.85,
   "end": 55.22,
   "syl_text": 5,
   "syl_audio": 5,
   "ratio": 1.11
  },
  {
   "i": 18,
   "text": "Paigambar Muhammad ka inteqaal hota hai.",
   "start": 55.64,
   "end": 57.67,
   "syl_text": 13,
   "syl_audio": 12,
   "ratio": 1.03
  },
  {
   "i": 19,
   "text": "Aur uske baad Arab registaan se ek toofan uthta hai.",
