   "text": "644 mein Arab fauj Sindhu nadi tak pahunchi, aur Umar ka hukum aaya: nadi paar nahi karni.",
   "start": 103.97,
   "end": 109.92,
   "syl_text": 31,
   "syl_audio": 28,
   "ratio": 1.0
  },
