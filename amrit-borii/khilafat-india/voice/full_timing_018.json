   "end": 540.48,
   "syl_text": 26,
   "syl_audio": 21,
   "ratio": 0.9
  },
  {
   "i": 189,
   "text": "Aur Khalifa al-Mahdi ne India par samundari hamle ka iraada hi chhod diya.",
