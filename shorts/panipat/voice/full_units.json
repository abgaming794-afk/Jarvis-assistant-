{
 "duration": 65.509,
 "units": [
  {
   "i": 0,
   "text": "Ek hi maidan, aur teen baar India ki kismat badal gayi.",
   "start": 0.0,
   "end": 2.81,
   "syl_text": 15,
   "syl_audio": 13,
   "ratio": 1.02
  },
  {
   "i": 1,
   "text": "Par sirf Panipat hi kyun?",
   "start": 3.29,
   "end": 4.37,
   "syl_text": 7,
   "syl_audio": 6,
   "ratio": 1.01
  },
  {
   "i": 2,
   "text": "21 April 1526.",
   "start": 4.87,
   "end": 6.32,
   "syl_text": 9,
   "syl_audio": 8,
   "ratio": 1.05
  },
  {
   "i": 3,
   "text": "Babur ke paas sirf 12,000 sainik, aur 15 se 20 topein.",
   "start": 6.72,
   "end": 9.79,
   "syl_text": 18,
   "syl_audio": 16,
   "ratio": 1.05
  },
  {
   "i": 4,
   "text": "Saamne Ibrahim Lodi.",
   "start": 10.15,
   "end": 11.24,
   "syl_text": 6,
   "syl_audio": 6,
   "ratio": 1.18
  },
  {
   "i": 5,
   "text": "50 se 70 hazaar sainik, aur 1,000 haathi.",
   "start": 11.49,
   "end": 13.92,
   "syl_text": 15,
   "syl_audio": 12,
   "ratio": 0.94
  },
  {
   "i": 6,
   "text": "Par topon ke dhamaakon se haathi bhadak gaye.",
   "start": 14.23,
   "end": 16.06,
   "syl_text": 13,
   "syl_audio": 11,
   "ratio": 1.0
  },
  {
   "i": 7,
   "text": "Lodi maara gaya, aur Mughal raaj shuru hua.",
   "start": 16.34,
   "end": 18.33,
   "syl_text": 12,
   "syl_audio": 8,
   "ratio": 0.79
  },
  {
   "i": 8,
   "text": "Sirf 30 saal baad, 1556.",
   "start": 18.71,
   "end": 20.62,
   "syl_text": 9,
   "syl_audio": 9,
   "ratio": 1.18
  },
  {
   "i": 9,
   "text": "Hemu, jo Delhi jeet kar Vikramaditya bane the, apne haathi Hawai par lad rahe the.",
   "start": 20.98,
   "end": 24.82,
   "syl_text": 23,
   "syl_audio": 22,
   "ratio": 1.13
  },
  {
   "i": 10,
   "text": "Ladaai barabar thi, tabhi ek teer laga.",
   "start": 25.1,
   "end": 26.87,
   "syl_text": 12,
   "syl_audio": 7,
   "ratio": 0.69
  },
  {
   "i": 11,
   "text": "Hemu behosh hue, aur poori fauj bikhar gayi.",
   "start": 27.18,
   "end": 29.24,
   "syl_text": 12,
   "syl_audio": 9,
   "ratio": 0.89
  },
  {
   "i": 12,
   "text": "Phir 14 January 1761.",
   "start": 29.71,
   "end": 31.41,
   "syl_text": 11,
   "syl_audio": 10,
   "ratio": 1.07
  },
  {
   "i": 13,
   "text": "Marathe aur Ahmad Shah Abdali aamne saamne.",
   "start": 31.69,
   "end": 33.83,
   "syl_text": 11,
   "syl_audio": 11,
   "ratio": 1.18
  },
  {
   "i": 14,
   "text": "Ye athaarahvi sadi ki sabse badi ladaaiyon mein se ek thi.",
   "start": 34.1,
   "end": 36.61,
   "syl_text": 17,
   "syl_audio": 14,
   "ratio": 0.97
  },
  {
   "i": 15,
   "text": "Sirf Maratha taraf, 30 hazaar se zyada maut.",
   "start": 36.96,
   "end": 39.15,
   "syl_text": 13,
   "syl_audio": 10,
   "ratio": 0.91
  },
  {
   "i": 16,
   "text": "Ab naksha dekho.",
   "start": 39.68,
   "end": 40.34,
   "syl_text": 5,
   "syl_audio": 4,
   "ratio": 0.94
  },
  {
   "i": 17,
   "text": "Kabul se Delhi ka purana raasta, Uttarapath, yahin se guzarta tha.",
   "start": 40.61,
   "end": 43.84,
   "syl_text": 22,
   "syl_audio": 17,
   "ratio": 0.91
  },
  {
   "i": 18,
   "text": "Ek taraf Yamuna, doosri taraf Thar registan.",
   "start": 44.14,
   "end": 46.38,
   "syl_text": 14,
   "syl_audio": 10,
   "ratio": 0.84
  },
  {
   "i": 19,
   "text": "Beech mein sapaat zameen, ghodon ke liye perfect.",
   "start": 46.62,
   "end": 49.01,
   "syl_text": 12,
   "syl_audio": 9,
   "ratio": 0.89
  },
  {
   "i": 20,
   "text": "Aur Delhi sirf 95 kilometre door.",
   "start": 49.24,
   "end": 51.01,
   "syl_text": 11,
   "syl_audio": 10,
   "ratio": 1.07
  },
  {
   "i": 21,
   "text": "Tarain 1192 aur Karnal 1739 bhi isi raaste pe lade gaye.",
   "start": 51.36,
   "end": 55.05,
   "syl_text": 23,
   "syl_audio": 19,
   "ratio": 0.98
  },
  {
   "i": 22,
   "text": "Matlab, Delhi chahiye toh pehle Panipat jeeto.",
   "start": 55.35,
   "end": 57.72,
   "syl_text": 13,
   "syl_audio": 12,
   "ratio": 1.09
  },
  {
   "i": 23,
   "text": "Aapke hisaab se kis ladaai ne India ko sabse zyada badla?",
