   "end": 2.51,
   "syl_text": 2,
   "syl_audio": 2,
   "ratio": 1.24
  },
  {
   "i": 2,
   "text": "Asli jawab ek devi ke mandir mein chhupa hai.",
   "start": 2.84,
   "end": 4.89,
   "syl_text": 14,
   "syl_audio": 11,
   "ratio": 0.97
  },
  {
   "i": 3,
   "text": "Kabhi yahan saat dweep the.",
   "start": 5.22,
   "end": 6.42,
   "syl_text": 7,
   "syl_audio": 5,
   "ratio": 0.88
  },
  {
   "i": 4,
   "text": "Colaba, Mahim, Worli, Parel.",
   "start": 6.7,
   "end": 8.82,
   "syl_text": 9,
   "syl_audio": 8,
   "ratio": 1.1
  },
  {
   "i": 5,
   "text": "Aur yahan rehte the Koli machhuare.",
   "start": 9.03,
   "end": 10.73,
   "syl_text": 9,
   "syl_audio": 8,
   "ratio": 1.1
  },
  {
   "i": 6,
   "text": "Koliyon ki kuldevi thi Mumba Devi.",
   "start": 11.02,
   "end": 12.71,
   "syl_text": 11,
   "syl_audio": 8,
   "ratio": 0.9
  },
  {
   "i": 7,
   "text": "Mumba yaani Maha Amba, aur Marathi mein Aai yaani maa.",
   "start": 12.99,
   "end": 16.44,
   "syl_text": 17,
   "syl_audio": 15,
   "ratio": 1.09
  },
  {
   "i": 8,
   "text": "Mumba aur Aai, bana Mumbai.",
   "start": 16.73,
   "end": 18.75,
   "syl_text": 8,
   "syl_audio": 8,
   "ratio": 1.24
  },
  {
   "i": 9,
   "text": "2nd century mein Greek bhugolvetta Ptolemy ne inhe kaha Heptanesia, yaani saat dweep.",
   "start": 19.09,
   "end": 23.89,
   "syl_text": 26,
   "syl_audio": 21,
   "ratio": 1.0
  },
  {
   "i": 10,
   "text": "1534 mein Gujarat ke Sultan Bahadur Shah ne ye dweep Portugal ko de diye.",
   "start": 24.08,
   "end": 28.07,
   "syl_text": 25,
   "syl_audio": 20,
   "ratio": 0.99
  },
  {
   "i": 11,
   "text": "Portuguese likhte the Bombaim.",
   "start": 28.28,
   "end": 29.79,
   "syl_text": 7,
   "syl_audio": 8,
   "ratio": 1.41
  },
  {
   "i": 12,
   "text": "Bom Baim yaani achhi khaadi?",
   "start": 30.02,
   "end": 32.49,
   "syl_text": 8,
   "syl_audio": 6,
   "ratio": 0.93
  },
  {
   "i": 13,
   "text": "Ye kahani mashhoor hai, par jaankaar ise galat maante hain.",
   "start": 32.73,
   "end": 35.47,
   "syl_text": 15,
   "syl_audio": 10,
   "ratio": 0.82
  },
  {
   "i": 14,
   "text": "1661 mein ye dweep dahej mein chale gaye!",
   "start": 35.79,
   "end": 37.97,
   "syl_text": 13,
   "syl_audio": 10,
   "ratio": 0.95
  },
  {
   "i": 15,
   "text": "Portugal ki Catherine ki shaadi England ke Raja Charles II se hui.",
   "start": 38.22,
   "end": 41.49,
   "syl_text": 22,
   "syl_audio": 16,
   "ratio": 0.9
  },
  {
   "i": 16,
   "text": "1668 mein England ne inhe East India Company ko sirf 10 pound saalana kiraye pe de diya.",
