   "end": 46.6,
   "syl_text": 29,
   "syl_audio": 23,
   "ratio": 0.98
  },
  {
   "i": 17,
   "text": "Naam pada Bombay.",
   "start": 46.79,
   "end": 47.88,
   "syl_text": 5,
   "syl_audio": 5,
   "ratio": 1.24
  },
  {
   "i": 18,
   "text": "Phir samundar bhar ke saaton dweep jode gaye, aur 1845 tak ek shehar ban gaya.",
